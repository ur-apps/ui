{
  "name": "@urapps/ui",
  "version": "1.0.0-1",
  "description": "UI kit for React apps",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "scripts": {
    "start:storybook": "storybook dev -p 6006",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "build:pack": "npm run build:lib && npm pack",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "simple-git-hooks",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:prerelease": "npm version prerelease && git push --follow-tags"
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./utils": "./lib/utils/index.js",
    "./styles": "./lib/index.css"
  },
  "typesVersions": {
    "*": {
      "utils": [
        "./lib/utils/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm test"
  },
  "keywords": [
    "ui-kit",
    "urapps"
  ],
  "license": "ISC",
  "author": "Garry Freeman <garryfreeman09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ur-apps/ui.git"
  },
  "homepage": "https://github.com/ur-apps/ui#readme",
  "bugs": {
    "url": "https://github.com/ur-apps/ui/issues"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@urapps/eslint-config": "^1.0.0-rc.2",
    "@urapps/prettier-config": "^1.0.0-rc.2",
    "@urapps/tsconfig": "^1.0.0-rc.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "sass-embedded": "^1.108.2",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@urapps/common": "^1.0.0-rc.3",
    "@urapps/react": "^1.0.0-rc.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.5"
  }
}
