{
  /* Visit https://aka.ms/tsconfig to read more about this file */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Modules
    "rootDir": ".",

    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "tests/**/*.spec.tsx",
    "tests/**/*.test.tsx",
    "src/vite-env.d.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "lib"]
}
